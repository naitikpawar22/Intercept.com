{
  "appId": "com.netscope.securitybrowser",
  "productName": "NetScope Security Browser",
  "directories": {
    "output": "dist/release"
  },
  "files": [
    "dist/**/*",
    "proxy/**/*",
    "database/**/*",
    "package.json"
  ],
  "win": {
    "target": ["nsis", "portable"]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
